<?xml version="1.0" encoding="utf-8"?>
<!--
  1x4 주간 위젯. 세로 예산이 작으므로 4x4 헤더를 축소해 사용한다.
  행 컨테이너에는 today_widget_month_row 하나만 들어간다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="2dp"
    android:paddingEnd="7dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/today_widget_month_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#1D1B20"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="13dp"
        android:orientation="horizontal">

        <TextView style="@style/TodayWidgetWeekday" android:text="일" />
        <TextView style="@style/TodayWidgetWeekday" android:text="월" />
        <TextView style="@style/TodayWidgetWeekday" android:text="화" />
        <TextView style="@style/TodayWidgetWeekday" android:text="수" />
        <TextView style="@style/TodayWidgetWeekday" android:text="목" />
        <TextView style="@style/TodayWidgetWeekday" android:text="금" />
        <TextView style="@style/TodayWidgetWeekday" android:text="토" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_widget_week_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

</LinearLayout>
