<?xml version="1.0" encoding="utf-8"?>
<!--
  1x4 주간 위젯. 세로 예산이 약 62dp뿐이라 4x4(상하 패딩 7dp, 요일 헤더 22dp)보다
  여백을 줄였다. 행 컨테이너에는 today_widget_month_row 하나만 들어간다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="4dp"
    android:paddingEnd="7dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:orientation="horizontal">

        <TextView style="@style/TodayWidgetWeekday" android:text="일" />
        <TextView style="@style/TodayWidgetWeekday" android:text="월" />
        <TextView style="@style/TodayWidgetWeekday" android:text="화" />
        <TextView style="@style/TodayWidgetWeekday" android:text="수" />
        <TextView style="@style/TodayWidgetWeekday" android:text="목" />
        <TextView style="@style/TodayWidgetWeekday" android:text="금" />
        <TextView style="@style/TodayWidgetWeekday" android:text="토" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_widget_week_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

</LinearLayout>
