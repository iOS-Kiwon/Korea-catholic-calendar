<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="7dp"
    android:paddingEnd="7dp"
    android:paddingBottom="7dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <TextView
            android:id="@+id/today_widget_month_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#1D1B20"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_widget_prev"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="#1D1B20"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_widget_today"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="46dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="오늘"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_widget_next"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="#1D1B20"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/today_widget_weekday_row"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:orientation="horizontal">

        <TextView style="@style/TodayWidgetWeekday" android:text="일" />
        <TextView style="@style/TodayWidgetWeekday" android:text="월" />
        <TextView style="@style/TodayWidgetWeekday" android:text="화" />
        <TextView style="@style/TodayWidgetWeekday" android:text="수" />
        <TextView style="@style/TodayWidgetWeekday" android:text="목" />
        <TextView style="@style/TodayWidgetWeekday" android:text="금" />
        <TextView style="@style/TodayWidgetWeekday" android:text="토" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_widget_month_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!--
      스냅샷에 없는 달로 넘어갔을 때 달력 격자 대신 보여주는 안내.
      위젯은 Flutter를 호출할 수 없어(RemoteViews) 스냅샷에 구워진 범위 밖의
      달은 그릴 수 없다. 예전에는 조용히 기준월 격자로 되돌아가 제목과 내용이
      어긋났다. 헤더(제목/‹/›/오늘)는 그대로 두어 반대 화살표나 `오늘`로 달력에
      돌아올 수 있게 한다.
    -->
    <LinearLayout
        android:id="@+id/today_widget_out_of_range"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/today_widget_out_of_range_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:textColor="#49454F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/today_widget_out_of_range_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/today_widget_action_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="앱으로 이동하기"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
