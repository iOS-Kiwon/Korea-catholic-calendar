<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 선택기(추가 화면)에서 보여줄 주간 위젯 미리보기 전용 레이아웃.
  실제 위젯(today_widget_week)은 RemoteViews로 값이 채워지지만, 미리보기에서는
  데이터가 바인딩되지 않아 빈 화면으로 보이므로 예시 값을 하드코딩해 둔다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="4dp"
    android:paddingEnd="7dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:orientation="horizontal">

        <TextView style="@style/TodayWidgetWeekday" android:text="일" />
        <TextView style="@style/TodayWidgetWeekday" android:text="월" />
        <TextView style="@style/TodayWidgetWeekday" android:text="화" />
        <TextView style="@style/TodayWidgetWeekday" android:text="수" />
        <TextView style="@style/TodayWidgetWeekday" android:text="목" />
        <TextView style="@style/TodayWidgetWeekday" android:text="금" />
        <TextView style="@style/TodayWidgetWeekday" android:text="토" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="19"
                android:textColor="#DA481C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="top|center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="주님 부활 대축일"
                android:textColor="#5D576B"
                android:textSize="7.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="20"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="top|center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="본당 바자회"
                android:textColor="#1D1B20"
                android:textSize="7.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="21"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="22"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="23"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="top|center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="성 마르코"
                android:textColor="#2E7D32"
                android:textSize="7.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="24"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="25"
                android:textColor="#DA481C"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
